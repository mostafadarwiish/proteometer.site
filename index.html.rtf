        /* ========== PORTAL ========== */\
        .portal \{ background: var(--navy); \}\
        .portal-grid \{ display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; \}\
\
        /* Dashboard mockup with isometric perspective */\
        .dash-perspective \{\
            transform: perspective(900px) rotateX(8deg) rotateY(-8deg);\
            transform-style: preserve-3d;\
        \}\
        .dash-wrap \{\
            background: var(--navy-mid);\
            border: 1px solid rgba(0,189,125,0.2);\
            padding: 1.5rem;\
            border-radius: 4px;\
        \}\
        .dash-header \{\
            display: flex; justify-content: space-between; align-items: center;\
            padding-bottom: 1rem; margin-bottom: 1rem;\
            border-bottom: 1px solid rgba(255,255,255,0.06);\
        \}\
        .dash-header h4 \{ font-family: var(--font-display); font-size: 0.8rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; \}\
        .dash-badge \{ font-size: 0.65rem; color: var(--primary); background: rgba(0,189,125,0.1); padding: 3px 10px; font-family: var(--font-mono); border-radius: 2px; \}\
        .dash-metrics \{ display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; \}\
        .dash-metric \{\
            background: rgba(255,255,255,0.04);\
            border: 1px solid rgba(255,255,255,0.06);\
            padding: 0.85rem 1rem;\
        \}\
        .dm-val \{ font-family: var(--font-display); font-size: 1.5rem; color: #fff; \}\
        .dm-val em \{ font-style: normal; color: var(--primary); \}\
        .dm-lbl \{ font-size: 0.6rem; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; \}\
        .dm-trend \{ font-size: 0.65rem; color: var(--primary); margin-top: 4px; \}\
        .dm-trend.warn \{ color: var(--warning); \}\
\
        /* Sparkline chart */\
        .dash-chart \{ background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); padding: 0.85rem 1rem; \}\
        .chart-label \{ font-size: 0.62rem; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 0.5rem; \}\
        .sparkline \{ display: flex; align-items: flex-end; gap: 3px; height: 48px; \}\
        .spark-bar \{ flex: 1; background: rgba(0,189,125,0.2); transition: background 0.2s; border-top: 1px solid rgba(0,189,125,0.5); \}\
        .spark-bar:hover \{ background: rgba(0,189,125,0.4); \}\
        .spark-bar.hi \{ background: rgba(0,189,125,0.5); border-top-color: var(--primary); \}\
\
        .portal-features \{ display: flex; flex-direction: column; gap: var(--sp-4); margin-top: 2rem; \}\
        .pf-item \{\
            display: flex; gap: var(--sp-4); align-items: flex-start;\
            padding-bottom: var(--sp-4);\
            border-bottom: 1px solid rgba(255,255,255,0.06);\
        \}\
        .pf-item:last-child \{ border:none; padding-bottom:0; \}\
        .pf-icon \{ width: 32px; height: 32px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,189,125,0.1); color: var(--primary); font-size: 0.85rem; \}\
        .pf-item strong \{ display: block; color: #fff; font-size: 0.85rem; margin-bottom: 2px; \}\
        .pf-item span \{ font-size: 0.8rem; color: rgba(255,255,255,0.4); line-height: 1.55; \}\
\
        /* ========== PARTNERS ========== */\
        .partners \{ background: var(--off-white); \}\
        .partner-grid \{ display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; \}\
        .partner-card \{\
            background: var(--surface);\
            border: 1px solid rgba(0,0,0,0.07);\
            padding: 2rem;\
            position: relative;\
            transition: transform 0.3s, box-shadow 0.3s;\
        \}\
        .partner-card:hover \{ transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.08); \}\
        /* Isometric depth effect on partner cards */\
        .partner-card::before \{\
            content: '';\
            position: absolute; bottom: -5px; right: -5px;\
            width: calc(100% - 4px); height: calc(100% - 4px);\
            border: 1px solid rgba(0,189,125,0.15);\
            z-index: -1;\
            transition: transform 0.3s;\
        \}\
        .partner-card:hover::before \{ transform: translate(3px, 3px); \}\
        .partner-card i \{ font-size: 1.8rem; color: var(--primary); margin-bottom: 1rem; display: block; \}\
        .partner-card h3 \{ font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text); margin-bottom: 0.6rem; \}\
        .partner-card p \{ font-size: 0.82rem; color: var(--slate); line-height: 1.65; \}\
        .p-status \{\
            display: inline-block; margin-top: 1rem;\
            font-size: 0.68rem; font-weight: 600; letter-spacing: 1px;\
            text-transform: uppercase; padding: 3px 10px;\
        \}\
        .ps-active  \{ background: #ECFDF5; color: #065F46; border-left: 2px solid #065F46; \}\
        .ps-pending \{ background: #FFFBEB; color: #92400E; border-left: 2px solid #92400E; \}\
        .ps-target  \{ background: #EFF6FF; color: #1E40AF; border-left: 2px solid #1E40AF; \}\
\
        /* ========== COMMUNICATION ========== */\
        .communication \{ background: var(--navy-light); \}\
        .comm-grid \{ display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; \}\
        .comm-card \{\
            background: rgba(255,255,255,0.04);\
            border: 1px solid rgba(255,255,255,0.08);\
            padding: 1.75rem;\
            transition: border-color 0.2s;\
        \}\
        .comm-card:hover \{ border-color: rgba(0,189,125,0.3); \}\
        .comm-card h3 \{\
            font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;\
            color: rgba(255,255,255,0.7); margin-bottom: 0.5rem;\
            display: flex; align-items: center; gap: var(--sp-2);\
        \}\
        .comm-card h3 i \{ color: var(--primary); \}\
        .comm-card > p \{ font-size: 0.82rem; color: rgba(255,255,255,0.35); line-height: 1.65; margin-bottom: 1.25rem; \}\
\
        /* Chat */\
        .chat-msg \{ display: flex; gap: var(--sp-2); margin-bottom: var(--sp-3); \}\
        .chat-av \{ width: 32px; height: 32px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 600; background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.6); \}\
        .chat-av.you \{ background: rgba(0,189,125,0.2); color: var(--primary); \}\
        .chat-bubble \{ background: rgba(255,255,255,0.06); padding: 8px 12px; \}\
        .chat-bubble p \{ font-size: 0.8rem; color: rgba(255,255,255,0.7); \}\
        .chat-time \{ font-size: 0.63rem; color: rgba(255,255,255,0.25); margin-top: 3px; \}\
\
        /* API block */\
        .api-block \{\
            background: #060e18; border: 1px solid rgba(0,189,125,0.2);\
            padding: 1rem 1.25rem;\
            font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.9;\
            color: rgba(255,255,255,0.7);\
        \}\
        .api-k \{ color: #7ab3cc; \}\
        .api-s \{ color: #ffd580; \}\
        .api-n \{ color: #ff9f6a; \}\
\
        /* Pub stats */\
        .pub-row \{ display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.82rem; \}\
        .pub-row:last-child \{ border:none; \}\
        .pub-row span \{ color: rgba(255,255,255,0.4); \}\
        .pub-row strong \{ color: var(--primary); \}\
        .pub-row strong.warn \{ color: var(--warning); \}\
\
        /* Training */\
        .training-item \{ display: flex; gap: var(--sp-3); align-items: center; padding: 10px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); margin-bottom: var(--sp-2); \}\
        .training-item i \{ color: var(--primary); font-size: 1.2rem; flex-shrink: 0; \}\
        .t-title \{ font-size: 0.82rem; color: rgba(255,255,255,0.75); font-weight: 500; \}\
        .t-meta \{ font-size: 0.7rem; color: rgba(255,255,255,0.3); \}\
        .progress-bar \{ height: 2px; background: rgba(255,255,255,0.08); margin-top: 6px; \}\
        .progress-fill \{ height: 100%; background: var(--primary); \}\
\
        /* ========== VALIDATION ========== */\
        .validation \{ background: var(--off-white); \}\
        .timeline \{ max-width: 800px; margin: 0 auto; position: relative; padding-left: 2rem; \}\
        .timeline::before \{\
            content: ''; position: absolute; left: 6px; top: 0; bottom: 0;\
            width: 1px; background: linear-gradient(180deg, var(--primary) 45%, rgba(0,0,0,0.1) 100%);\
        \}\
        .tl-item \{ position: relative; margin-bottom: 2.25rem; \}\
        .tl-dot \{\
            position: absolute; left: -2.35rem; top: 0.3rem;\
            width: 12px; height: 12px;\
            background: var(--primary);\
            border: 2px solid var(--off-white);\
            box-shadow: 0 0 0 2px var(--primary);\
        \}\
        .tl-dot.pending \{ background: var(--off-white); box-shadow: 0 0 0 2px rgba(0,0,0,0.15); \}\
        .tl-date \{\
            display: inline-flex; align-items: center;\
            font-size: 0.65rem; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;\
            padding: 3px 10px; margin-bottom: 0.5rem;\
        \}\
        .tl-date.done \{ background: var(--primary); color: var(--navy); \}\
        .tl-date.active \{ background: var(--navy); color: var(--primary); border: 1px solid var(--primary); \}\
        .tl-date.pending \{ background: rgba(0,0,0,0.06); color: var(--slate); \}\
        .tl-item h4 \{ font-size: 1rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text); margin-bottom: 0.35rem; \}\
        .tl-item p \{ font-size: 0.85rem; color: var(--slate); line-height: 1.65; \}\
\
        /* ========== CTA ========== */\
        .cta-section \{\
            background: var(--navy);\
            padding: 7rem 0;\
            position: relative; overflow: hidden;\
            text-align: center;\
        \}\
        /* Isometric grid accent */\
        .cta-grid-bg \{\
            position: absolute; inset: 0;\
            background-image:\
                linear-gradient(rgba(0,189,125,0.05) 1px, transparent 1px),\
                linear-gradient(90deg, rgba(0,189,125,0.05) 1px, transparent 1px);\
            background-size: 48px 48px;\
            pointer-events: none;\
        \}\
        .cta-glow \{ position: absolute; top:50%; left:50%; transform: translate(-50%,-50%); width:600px; height:400px; background: radial-gradient(ellipse, rgba(0,189,125,0.1) 0%, transparent 70%); pointer-events:none; \}\
        .cta-inner \{ position: relative; z-index: 2; \}\
        .cta-section h2 \{ font-size: clamp(2rem, 4vw, 3rem); color: #fff; text-transform: uppercase; margin-bottom: 1rem; letter-spacing: 1px; \}\
        .cta-section p \{ font-size: 1rem; color: rgba(255,255,255,0.5); max-width: 560px; margin: 0 auto 2.5rem; line-height: 1.75; \}\
        .cta-btns \{ display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; \}\
\
        /* ========== FOOTER ========== */\
        footer \{ background: #06111e; padding: 4rem 0 2rem; \}\
        .footer-inner \{ max-width: 1200px; margin: 0 auto; padding: 0 var(--sp-8); \}\
        .footer-top \{ display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; padding-bottom: 3rem; border-bottom: 1px solid rgba(255,255,255,0.06); \}\
        .footer-brand .logo \{ display: block; margin-bottom: 1rem; \}\
        .footer-brand p \{ font-size: 0.82rem; color: rgba(255,255,255,0.3); line-height: 1.7; \}\
        .footer-col h4 \{ font-family: var(--font-display); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1.5px; color: rgba(255,255,255,0.6); margin-bottom: 1.25rem; \}\
        .footer-col ul \{ list-style: none; display: flex; flex-direction: column; gap: 0.6rem; \}\
        .footer-col a \{ font-size: 0.82rem; color: rgba(255,255,255,0.3); transition: color 0.2s; \}\
        .footer-col a:hover \{ color: var(--primary); \}\
        .footer-bottom \{ display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-top: 2rem; \}\
        .footer-bottom p \{ font-size: 0.75rem; color: rgba(255,255,255,0.2); \}\
        .social-links \{ display: flex; gap: var(--sp-4); \}\
        .social-links a \{ color: rgba(255,255,255,0.25); font-size: 0.95rem; transition: color 0.2s; \}\
        .social-links a:hover \{ color: var(--primary); \}\
\
        /* ========== SCROLL ANIMATIONS ========== */\
        .reveal \{ opacity:0; transform: translateY(28px); transition: opacity 0.6s ease, transform 0.6s ease; \}\
        .reveal.in \{ opacity:1; transform: none; \}\
        .reveal-left \{ opacity:0; transform: translateX(-28px); transition: opacity 0.6s ease, transform 0.6s ease; \}\
        .reveal-left.in \{ opacity:1; transform: none; \}\
        .reveal-right \{ opacity:0; transform: translateX(28px); transition: opacity 0.6s ease, transform 0.6s ease; \}\
        .reveal-right.in \{ opacity:1; transform: none; \}\
\
        /* ========== RESPONSIVE ========== */\
        @media (max-width: 960px) \{\
            .hero-inner \{ grid-template-columns: 1fr; gap: 3rem; \}\
            .hero-device \{ display: none; \}\
            .sol-grid, .portal-grid \{ grid-template-columns: 1fr; gap: 3rem; \}\
            .tech-grid, .partner-grid \{ grid-template-columns: 1fr 1fr; \}\
            .stats-inner \{ grid-template-columns: 1fr 1fr; \}\
            .stat-cell \{ border-bottom: 1px solid rgba(255,255,255,0.06); \}\
            .footer-top \{ grid-template-columns: 1fr 1fr; \}\
            .nav-links \{ display: none; \}\
            .nav-cta \{ display: none; \}\
            .hamburger \{ display: flex; \}\
        \}\
        @media (max-width: 600px) \{\
            .problem-grid \{ grid-template-columns: 1fr; \}\
            .tech-grid, .partner-grid, .comm-grid \{ grid-template-columns: 1fr; \}\
            .stats-inner \{ grid-template-columns: 1fr 1fr; \}\
            .footer-top \{ grid-template-columns: 1fr; \}\
            .hero h1 \{ font-size: 2.4rem; \}\
            .section \{ padding: 5rem 0; \}\
        \}\
    </style>\
</head>\
